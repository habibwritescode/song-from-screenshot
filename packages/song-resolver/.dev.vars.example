# Copy to .dev.vars for local dev and fill in. Never commit .dev.vars.
# For a deployed Worker, run `npm run setup -w song-resolver` instead.

# Required
ANTHROPIC_API_KEY=
# A long random string; generate with: openssl rand -base64 32
ACCESS_TOKEN=

# Cloudflare's Deploy button makes a required field for every key here and every
# binding described in package.json (cloudflare.bindings), so the optional keys
# are left out of both. Uncomment the ones you use.

# Recommended: direct Spotify links (developer.spotify.com/dashboard → Create app)
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Optional
# YOUTUBE_API_KEY=
