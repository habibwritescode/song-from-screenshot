{
  "name": "chrome-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning build.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning build.ts --watch",
    "zip": "npm run build && cd dist && rm -f ../song-from-screenshot-extension-$npm_package_version.zip && zip -qrX ../song-from-screenshot-extension-$npm_package_version.zip .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.4",
    "song-resolver": "*",
    "vitest": "^5.0.5"
  }
}
