/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# The file name carries the font version, so a new version gets a new name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
